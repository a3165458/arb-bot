# arb-bot 运行配置。所有项都有默认值，这里列出的都是可调项。
# 复制成 .env 后按需修改；CLI 与看板都会读它。

# 场所白名单（逗号分隔）。留空 = 全部 15 家。拼错的名字会直接报错，不会静默跳过。
# lighter-rh 按出口 IP 限频且额度很紧：同一台机器上有实盘程序在用 api.rh.lighter.xyz 时，
# 把它排除在外，否则看板的轮询会和实盘抢同一份额度。
# ARB_VENUES=arcus,aster,binance,bitget,bybit,gate,hyperliquid,hyperliquid-io,hyperliquid-xyz,lighter,mexc,okx,ourbit,variational

# 单边吃单费率的**回落值**：交易所公开接口报了真实费率时用真实的，
# 只有拿不到费率的场所（Binance / OKX / Bybit / Aster / Hyperliquid / Variational）用它。
ARB_FEE_PER_SIDE=0.0005

# 计划持有天数。一次往返的 4 笔手续费摊到这些天上。
# 取 1 天等于假设只持有 1 天 —— 会把一次性成本当成每日成本，既筛掉真实可盈利的
# 机会又鼓励高换手。回测（120 天 / 39 币种）在 7 天口径下最优。
ARB_AMORTIZE_DAYS=7

# 价差套利的计划持有天数（预期基差收敛要多久）。只影响年化折算。
ARB_SPREAD_HOLD_DAYS=3

# 不利入场基差的上限（%）。进场时空腿比多腿便宜超过这个数就不推荐 ——
# 那要靠基差反向扩大才赚得回来，是在赌均值回归不会发生。
# 实测入场基差中位数 +0.013%、p10 -0.224%；0.5 只挡掉 3.2% 的机会。
# 填 off 关闭门槛（被挡下的配对会逐条列出，不是静默丢弃）。
ARB_MAX_ENTRY_BASIS_PCT=0.5

# 两腿各自的逐仓杠杆（1 ~ 100）。只影响强平距离与保证金年化，不影响排名。
ARB_LEVERAGE=3

# 执行层闸门（arb-paper）。
# 单笔最大名义额（计价币）。off = 不设上限：单笔多大只由盘口深度（限价以内吃得满）、保证金与强平距离决定。
ARB_MAX_POSITION_USDT=1000
ARB_MAX_DAILY_LOSS_USDT=100

# 一个合约至少要有几家场所才参与配对。
ARB_MIN_VENUES=2

# 单个 HTTP 请求超时（秒）。
ARB_HTTP_TIMEOUT_SEC=15

# 看板监听地址与端口。默认只监听回环 —— 面板展示的是费率结构与交易机会，
# 对外暴露前请自己在前面加鉴权。
ARB_BIND_HOST=127.0.0.1
ARB_HTTP_PORT=8080

# 后台快照刷新间隔（秒）。一次扫描会并发打十几家公共接口，
# 间隔太短会把上游请求数乘上并发数，直接换来 429。
ARB_SCAN_INTERVAL_SEC=60

# 日志过滤（tracing 的 EnvFilter 语法）。日志写 stderr，stdout 留给 --json。
ARB_LOG=info

# 优雅停机：收到 SIGINT / SIGTERM 后最多等多少秒（1 ~ 300），让进行中的下单 / 平仓 / 规则轮做完再退出，
# 并且不再受理新的。超时照样退出并告警。pm2 的 kill_timeout 由 ecosystem.config.js 按它 + 30 秒推出；
# systemd 用 deploy/arb-web.service 里的 TimeoutStopSec（改了这里记得同步）。
# ARB_SHUTDOWN_GRACE_SEC=120

# ---- 看板交易（arb-web）----
# 看板上的交易接口（纸面 / 实盘下单、平仓、执行规则）都要这个令牌，至少 16 个字符。
# 不配 = 交易接口全部关闭，看板只能看。页面右上角「令牌」里填同一个值（只存在本浏览器）。
# 生成：openssl rand -hex 24
# ARB_WEB_TOKEN=
# 纸面台账的规则由看板后台每隔多少秒执行一轮。0 = 不执行（用 arb-paper --watch，两者别同时跑）。
# ARB_WEB_PAPER_WATCH_SEC=0
# 策略页后台预检记住的「最近用过的参数」（场所对、策略、金额、杠杆、模式）存在这里：
# 网页关着、看板重启也按它们在后台继续预检，打开页面就有现成的结论。
# ARB_PRECHECK_STATE=arb-precheck-watches.json

# 告警通知（Telegram，可选）：规则平仓 / 失败、外部平仓被识别、裸敞口、对账连续 3 轮不一致、
# 盈亏核算完成、实盘手动开平仓、服务启动都会推送；同类消息 30 分钟内只发一次，每分钟最多 6 条。
# 消息里不含地址 / 账户号 / 密钥。两个都要配；密钥自己写在这里，不要发给任何人。
# 创建机器人：Telegram 里找 @BotFather → /newbot；chat id：给机器人发一句话后访问
# https://api.telegram.org/bot<TOKEN>/getUpdates 看 chat.id。
# ARB_ALERT_TELEGRAM_TOKEN=
# ARB_ALERT_TELEGRAM_CHAT=
# 配了上面两项，机器人同时提供菜单命令（/menu /status /positions /daily /balance /top /mute /pause …）。
# 只有「私聊、且用户 ID 等于管理员 ID」的消息会被处理，别人和群里的一律静默忽略。
# 管理员 ID 默认取 ARB_ALERT_TELEGRAM_CHAT（私聊的 chat id 就是你的用户 ID）；那一项是群 / 频道（负数）时
# 必须另配你自己的用户 ID：
# ARB_TELEGRAM_ADMIN_ID=
# 只想要告警、不要命令时：
# ARB_TELEGRAM_COMMANDS=off

# 看板实盘：off（默认）/ readonly（只连接、对账、出计划）/ trade（真实下单）。
# 开着实盘时看板持有各家订单意图日志的独占锁：arb-live 不能同时连同一批账户。
# 实盘的场所、凭据与下方 arb-live 段落共用（ARB_LIVE_VENUES、ARB_HL_* ……）。
# ARB_WEB_LIVE=off
# trade 模式必填：平仓 / 回滚 / 减仓的价格保护，小数（0.003 = 0.3%），上限 0.05。
# ARB_WEB_MARKET_SLIPPAGE=0.003
# 实盘持仓规则由看板后台每隔多少秒执行一轮（默认同 ARB_SCAN_INTERVAL_SEC）。0 = 不自动执行。
# ARB_WEB_LIVE_WATCH_SEC=60
# 实盘台账与订单意图日志目录，默认与 arb-live 相同。
# ARB_LIVE_LEDGER=arb-live-ledger.jsonl
# ARB_LIVE_JOURNAL_DIR=.

# ---- 实盘（arb-live）----
# arb-live 与看板实盘（ARB_WEB_LIVE）读取这些变量。默认只读；真实下单还需要命令行的
# --enable-trading 与 --market-slippage。请用专用账户与专用 API key。
# 私钥只放在本机 .env（已被 .gitignore 忽略），不要提交。
# ARB_LIVE_VENUES 留空或 auto（默认）= 按凭据自动识别：下面填齐了哪几家就连哪几家（至少两家；
# Hyperliquid 钥匙齐全时主站与 HIP-3 的 xyz / io 一起连上，各 dex 保证金独立）。也可以显式列出，如 hyperliquid,lighter。
# 看板「持仓 → 实盘」页会列出每家的识别结果（不显示任何密钥）。Ourbit、Variational 不支持实盘。
# ARB_LIVE_VENUES=auto

# Hyperliquid（主 dex 与 hyperliquid-xyz / hyperliquid-io 共用）
# ARB_HL_PRIVATE_KEY=
# ARB_HL_ACCOUNT_ADDRESS=

# Lighter 主网 / Robinhood Chain（lighter-rh）
# ARB_LIGHTER_ACCOUNT_INDEX=
# ARB_LIGHTER_API_KEY_INDEX=
# ARB_LIGHTER_API_PRIVATE_KEY=
# ARB_LIGHTER_RH_ACCOUNT_INDEX=
# ARB_LIGHTER_RH_API_KEY_INDEX=
# ARB_LIGHTER_RH_API_PRIVATE_KEY=
# 官方签名库 v1.0.10：https://github.com/elliottech/lighter-go/releases/download/v1.0.10/lighter-signer-linux-amd64.so
# ARB_LIGHTER_SIGNER_LIB=/opt/lighter/lighter-signer-linux-amd64.so

# CEX：账户须为单向持仓；各家其它前提见 README「实盘执行」
# ARB_BINANCE_API_KEY=
# ARB_BINANCE_API_SECRET=
# ARB_BYBIT_API_KEY=
# ARB_BYBIT_API_SECRET=
# ARB_OKX_API_KEY=
# ARB_OKX_API_SECRET=
# ARB_OKX_PASSPHRASE=
# ARB_BITGET_API_KEY=
# ARB_BITGET_API_SECRET=
# ARB_BITGET_PASSPHRASE=
# ARB_GATE_API_KEY=
# ARB_GATE_API_SECRET=
# ARB_MEXC_API_KEY=
# ARB_MEXC_API_SECRET=

# Aster v3（API 钱包）
# ARB_ASTER_USER=
# ARB_ASTER_SIGNER=
# ARB_ASTER_SIGNER_PRIVATE_KEY=

# Arcus（永续目前白名单内测）：在 app.arcus.xyz/api-keys 用钱包生成 API key，
# 复制只显示一次的「API Signing Key」；子账户序号是生成时选的 Subaccount #（默认 0）。
# 钱包私钥不需要。
# ARB_ARCUS_ADDRESS=
# ARB_ARCUS_ACCOUNT_INDEX=0
# ARB_ARCUS_API_PRIVATE_KEY=
